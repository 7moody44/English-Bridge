# Application Configuration
VITE_APP_NAME=English Bridge
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Progressive English Learning Platform

# Database Configuration
VITE_MONGODB_URI=your_mongodb_connection_string
VITE_DATABASE_NAME=englishbridge

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=10000

# Audio Configuration
VITE_AUDIO_VOICE_LANG=en-US
VITE_AUDIO_VOICE_RATE=1.0
VITE_AUDIO_VOICE_PITCH=1.0

# Development Configuration
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=info